# ╔══════════════════════════════════════════════════════════╗
# ║          claw — Control Local Agents Workspace           ║
# ║          Скопируй в .env и вставь свои токены            ║
# ╚══════════════════════════════════════════════════════════╝

# ─── Сервер ──────────────────────────────────────────────────────────────────
CLAW_HOST=127.0.0.1
CLAW_PORT=8765
CLAW_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Опционально: зашифровать токены в .env. Если задан — все значения с
# префиксом "enc:" декриптуются автоматически при запуске.
# CLAW_MASTER_PASSWORD=

# ─── LLM: Ollama (локально) ──────────────────────────────────────────────────
# Установка: https://ollama.ai  →  ollama pull qwen2.5:7b
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_DEFAULT_MODEL=qwen2.5:7b

# ─── LLM: Qwen local (любой OpenAI-совместимый сервер) ───────────────────────
# LM Studio, vLLM, llama.cpp server, Qwen.cpp — все подойдут.
QWEN_LOCAL_BASE_URL=http://127.0.0.1:8000/v1
QWEN_LOCAL_API_KEY=not-needed
QWEN_LOCAL_DEFAULT_MODEL=Qwen2.5-7B-Instruct

# ─── LLM: Qwen cloud (Alibaba DashScope) ─────────────────────────────────────
# https://dashscope.aliyuncs.com/compatible-mode/v1
# Регистрация: https://www.aliyun.com → DashScope → API Key
QWEN_CLOUD_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_CLOUD_API_KEY=
QWEN_CLOUD_DEFAULT_MODEL=qwen-plus

# ─── ВКонтакте ───────────────────────────────────────────────────────────────
# Implicit Flow (заменить YOUR_APP_ID на id приложения vk.com/apps):
# https://oauth.vk.com/authorize?client_id=YOUR_APP_ID&display=page
#   &redirect_uri=https://oauth.vk.com/blank.html
#   &scope=friends,wall,messages,offline&response_type=token&v=5.199
# Токен появится в URL после редиректа: #access_token=...
VK_ACCESS_TOKEN=
VK_API_VERSION=5.199

# ─── Telegram Bot API ─────────────────────────────────────────────────────────
# 1. Создай бота у @BotFather → получи токен вида 123456789:AAA...
# 2. Напиши боту сообщение, затем открой:
#    https://api.telegram.org/bot<TOKEN>/getUpdates — найди "chat":{"id":...}
# 3. Для Webhook (мгновенная реакция): укажи публичный URL (ngrok/cloudflare)
TELEGRAM_BOT_TOKEN=
TELEGRAM_DEFAULT_CHAT_ID=
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=

# ─── Discord Bot ─────────────────────────────────────────────────────────────
# discord.com/developers/applications → New Application → Bot → Token
# Invite URL: https://discord.com/api/oauth2/authorize?client_id=ID&permissions=2048&scope=bot
DISCORD_BOT_TOKEN=
DISCORD_DEFAULT_CHANNEL_ID=

# ─── Steam Web API ───────────────────────────────────────────────────────────
# Key:    https://steamcommunity.com/dev/apikey
# UserID: 17-значный SteamID64 (найти: https://steamid.io)
STEAM_API_KEY=
STEAM_USER_ID=

# ─── Spotify ─────────────────────────────────────────────────────────────────
# 1. developer.spotify.com/dashboard → Create App → добавь Redirect URI:
#    http://localhost:8888/callback
# 2. Открой в браузере (вставь свой CLIENT_ID):
#    https://accounts.spotify.com/authorize?client_id=CLIENT_ID
#      &response_type=code&redirect_uri=http://localhost:8888/callback
#      &scope=user-read-currently-playing%20user-read-playback-state%20user-modify-playback-state
# 3. Скопируй ?code=... из URL после входа
# 4. Обменяй на refresh_token через curl (см. docs/spotify-auth.md)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=

# ─── Хранилище ───────────────────────────────────────────────────────────────
CLAW_DB_PATH=data/claw.sqlite
