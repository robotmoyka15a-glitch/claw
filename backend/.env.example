# ---- claw backend configuration ----

# Where the API listens. Keep it on loopback.
CLAW_HOST=127.0.0.1
CLAW_PORT=8765

# CORS origins for the Vite dev server / packaged frontend.
CLAW_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# ---- VK ----
# Get a user access token via Implicit Flow:
# https://oauth.vk.com/authorize?client_id=YOUR_APP_ID&display=page&redirect_uri=https://oauth.vk.com/blank.html&scope=friends,wall,offline&response_type=token&v=5.199
VK_ACCESS_TOKEN=
VK_API_VERSION=5.199

# ---- LLM: Ollama (local) ----
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_DEFAULT_MODEL=qwen2.5:7b

# ---- LLM: Qwen local (any OpenAI-compatible server: vLLM, LM Studio, llama.cpp) ----
QWEN_LOCAL_BASE_URL=http://127.0.0.1:8000/v1
QWEN_LOCAL_API_KEY=not-needed
QWEN_LOCAL_DEFAULT_MODEL=Qwen2.5-7B-Instruct

# ---- LLM: Qwen cloud (Alibaba DashScope, OpenAI-compatible endpoint) ----
# https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_CLOUD_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_CLOUD_API_KEY=
QWEN_CLOUD_DEFAULT_MODEL=qwen-plus

# ---- Telegram Bot API ----
# Create a bot via @BotFather. For monitoring one specific chat, put its
# numeric id into TELEGRAM_DEFAULT_CHAT_ID (you can find it by messaging the
# bot and looking at /getUpdates, or via @userinfobot).
TELEGRAM_BOT_TOKEN=
TELEGRAM_DEFAULT_CHAT_ID=

# ---- Discord Bot ----
# https://discord.com/developers/applications -> New Application -> Bot.
# Copy the token. Invite the bot to your server with "Send Messages" perm.
DISCORD_BOT_TOKEN=
DISCORD_DEFAULT_CHANNEL_ID=

# ---- Steam Web API ----
# Key: https://steamcommunity.com/dev/apikey
# STEAM_USER_ID must be SteamID64 (the 17-digit number, e.g. 76561198...).
STEAM_API_KEY=
STEAM_USER_ID=

# ---- Spotify ----
# Create an app at https://developer.spotify.com/dashboard
# SPOTIFY_REFRESH_TOKEN: obtained once via Authorization Code flow with scope
# "user-read-currently-playing user-read-playback-state user-modify-playback-state".
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=

# SQLite database path (relative to backend/)
CLAW_DB_PATH=data/claw.sqlite
